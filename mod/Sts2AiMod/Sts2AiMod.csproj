<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-game mod. Build: dotnet build -c Release -p:GameDir=<game dir>; install: tools/install_release_mod.sh -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sts2ai</AssemblyName>
    <RootNamespace>Sts2AiMod</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>13.0</LangVersion>
    <NoWarn>$(NoWarn);CS8500;CS0436</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2</GameDir>
    <GameData>$(GameDir)/data_sts2_linuxbsd_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shared/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameData)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameData)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
